{
  "name": "calorie-compass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-migrate-deploy-if-configured.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "check:food-pipeline": "node scripts/check-food-pipeline.mjs",
    "qa:assistant": "vitest run tests/assistant-qa.test.ts tests/assistant-real-user-gauntlet.test.ts tests/meal-assistant-conversation.test.ts tests/meal-assistant-runner.test.ts tests/meal-logger-client.test.tsx --pool=forks --maxWorkers=1 --no-file-parallelism",
    "test:assistant": "vitest run tests/assistant-qa.test.ts",
    "test:food-intelligence": "vitest run tests/food-intelligence-engine.test.ts tests/food-intelligence-release-corpus.test.ts tests/food-search-regression.test.ts tests/food-search-service.test.ts tests/nutrition-provider-integration.test.ts tests/nutrition-provider-query-matrix.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism",
    "test:food-search": "vitest run tests/food-search.test.ts tests/food-search-regression.test.ts tests/food-search-route.test.ts tests/food-search-service.test.ts tests/barcode-lookup.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism",
    "test:release-food": "npm run test:food-intelligence && npm run test:food-search && npm run qa:assistant && npm run reliability:nutrition",
    "smoke:preview": "node scripts/preview-food-intelligence-smoke.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "predeploy:check": "vitest run && eslint && next build && npm run qa:assistant && npm run reliability:nutrition",
    "catalog:sync": "node scripts/sync-nutrition-catalog.js",
    "postinstall": "prisma generate",
    "benchmark:nutrition": "vitest run tests/nutrition-accuracy-baseline.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism",
    "golden:nutrition": "vitest run tests/nutrition-golden-dataset.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism",
    "reliability:nutrition": "npm run benchmark:nutrition && npm run golden:nutrition"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "openai": "^6.37.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
