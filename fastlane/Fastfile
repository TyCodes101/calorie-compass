default_platform(:ios)

platform :ios do
  desc "Archive Calorie Compass and upload the build to TestFlight. Requires CI-provided signing and App Store Connect secrets."
  lane :testflight_upload do
    required_env = %w[
      APP_IDENTIFIER
      APPLE_TEAM_ID
      ASC_KEY_ID
      ASC_ISSUER_ID
      ASC_KEY_FILEPATH
      MATCH_PROVISIONING_PROFILE_NAME
    ]

    missing = required_env.select { |key| ENV[key].to_s.strip.empty? }
    UI.user_error!("Missing required environment variables: #{missing.join(', ')}") unless missing.empty?

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_FILEPATH"),
      duration: 1200,
      in_house: false
    )

    increment_build_number(
      xcodeproj: "ios/CalorieCompass/CalorieCompass.xcodeproj",
      build_number: ENV.fetch("BUILD_NUMBER", ENV.fetch("GITHUB_RUN_NUMBER", Time.now.utc.strftime("%Y%m%d%H%M")))
    )

    build_app(
      project: "ios/CalorieCompass/CalorieCompass.xcodeproj",
      scheme: "CalorieCompass",
      configuration: "Release",
      clean: true,
      output_directory: "artifacts/testflight",
      output_name: "CalorieCompass.ipa",
      export_method: "app-store",
      xcargs: [
        "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
        "PRODUCT_BUNDLE_IDENTIFIER=#{ENV.fetch('APP_IDENTIFIER')}",
        "CODE_SIGN_STYLE=Manual"
      ].join(" "),
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        provisioningProfiles: {
          ENV.fetch("APP_IDENTIFIER") => ENV.fetch("MATCH_PROVISIONING_PROFILE_NAME")
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "artifacts/testflight/CalorieCompass.ipa",
      skip_waiting_for_build_processing: ENV.fetch("SKIP_WAITING_FOR_BUILD_PROCESSING", "false") == "true",
      distribute_external: false,
      notify_external_testers: false,
      changelog: ENV.fetch("TESTFLIGHT_CHANGELOG", "Internal release-candidate build. TestFlight readiness is not claimed until manual evidence is recorded.")
    )
  end
end
